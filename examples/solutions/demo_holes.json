{
  "format": 1,
  "name": "demo_holes",
  "plugin_dirs": [
    "../plugins"
  ],
  "variables": {
    "reward": {
      "value": 0.0,
      "dtype": "float",
      "description": "reward for the learning flow"
    },
    "product": {
      "value": "PART-A",
      "dtype": "string",
      "description": "current product code"
    }
  },
  "comm": {
    "devices": [
      {
        "name": "plc",
        "kind": "tcp_server",
        "config": {
          "host": "0.0.0.0",
          "port": 6000,
          "terminator": "\\n"
        }
      }
    ],
    "receive_rules": [
      {
        "name": "trigger",
        "device": "plc",
        "match": "startswith",
        "pattern": "TRIG",
        "action": "trigger_flow",
        "flow": "main",
        "enabled": true
      }
    ],
    "send_rules": [
      {
        "name": "result",
        "device": "plc",
        "flow": "main",
        "when": "always",
        "template": "{status},{out.holes},{out.width:.1f}\\n",
        "enabled": true
      }
    ]
  },
  "flows": [
    {
      "name": "main",
      "description": "Count the three holes of the part and measure its width.",
      "nodes": [
        {
          "id": "d930c43c",
          "type": "source.image_folder",
          "name": "Folder",
          "enabled": true,
          "position": [
            40.0,
            60.0
          ],
          "values": {
            "directory": "../images",
            "mode": "next",
            "index": 0,
            "loop": true,
            "grayscale": false
          }
        },
        {
          "id": "c7ec2d0d",
          "type": "preprocess.color",
          "name": "Gray",
          "enabled": true,
          "position": [
            250.0,
            60.0
          ],
          "values": {
            "mode": "gray",
            "channel": -1
          }
        },
        {
          "id": "7aac1a12",
          "type": "preprocess.threshold",
          "name": "Threshold",
          "enabled": true,
          "position": [
            460.0,
            60.0
          ],
          "values": {
            "method": "binary_inv",
            "thresh": 120,
            "high": 255,
            "block_size": 31,
            "c": 5.0
          }
        },
        {
          "id": "bac395df",
          "type": "preprocess.morphology",
          "name": "Open",
          "enabled": true,
          "position": [
            670.0,
            60.0
          ],
          "values": {
            "op": "open",
            "shape": "ellipse",
            "ksize": 3,
            "iterations": 1
          }
        },
        {
          "id": "e79528b5",
          "type": "analysis.blob",
          "name": "Holes",
          "enabled": true,
          "position": [
            880.0,
            60.0
          ],
          "values": {
            "min_area": 500,
            "max_area": 5000,
            "min_width": 0,
            "min_height": 0,
            "connectivity": "8",
            "sort": "area_desc",
            "max_count": 100
          }
        },
        {
          "id": "19ac40f8",
          "type": "logic.judge",
          "name": "Hole Count",
          "enabled": true,
          "position": [
            1090.0,
            60.0
          ],
          "values": {
            "op": "==",
            "low": 3.0,
            "high": 100.0,
            "text": "",
            "name": "holes"
          }
        },
        {
          "id": "7954d0da",
          "type": "analysis.caliper",
          "name": "Width",
          "enabled": true,
          "position": [
            880.0,
            220.0
          ],
          "values": {
            "roi": {
              "x": 60.0,
              "y": 150.0,
              "w": 520.0,
              "h": 24.0,
              "angle": 0.0
            },
            "direction": "horizontal",
            "polarity": "any",
            "min_contrast": 15.0,
            "select": "first_last",
            "smooth": 3
          }
        },
        {
          "id": "5073e706",
          "type": "logic.judge",
          "name": "Width OK",
          "enabled": true,
          "position": [
            1090.0,
            220.0
          ],
          "values": {
            "op": "in_range",
            "low": 390.0,
            "high": 410.0,
            "text": "",
            "name": "width"
          }
        },
        {
          "id": "7e9bc93f",
          "type": "output.publish",
          "name": "Publish",
          "enabled": true,
          "position": [
            1300.0,
            60.0
          ],
          "values": {
            "name_a": "holes",
            "name_b": "width",
            "name_c": "c",
            "name_d": "d"
          }
        },
        {
          "id": "90ba84ab",
          "type": "output.render",
          "name": "Render",
          "enabled": true,
          "position": [
            1300.0,
            220.0
          ],
          "values": {
            "thickness": 1,
            "stamp_result": true
          }
        },
        {
          "id": "cbd7ea5c",
          "type": "output.save_image",
          "name": "Save NG",
          "enabled": true,
          "position": [
            1510.0,
            220.0
