{
  "format": 1,
  "name": "demo_holes",
  "plugin_dirs": [
    "../plugins"
  ],
  "variables": {
    "reward": {
      "value": 0.0,
      "dtype": "float",
      "description": "学习流程的奖励"
    },
    "product": {
      "value": "PART-A",
      "dtype": "string",
      "description": "当前产品型号"
    }
  },
  "comm": {
    "devices": [
      {
        "name": "plc",
        "kind": "tcp_server",
        "config": {
          "host": "0.0.0.0",
          "port": 6000,
          "terminator": "\\n",
          "heartbeat_s": 0,
          "heartbeat_text": "HB\\n"
        }
      }
    ],
    "receive_rules": [
      {
        "name": "trigger",
        "device": "plc",
        "match": "startswith",
        "pattern": "TRIG",
        "action": "trigger_flow",
        "flow": "main",
        "enabled": true
      }
    ],
    "send_rules": [
      {
        "name": "result",
        "device": "plc",
        "flow": "main",
        "when": "always",
        "template": "{status},{out.holes},{out.width:.1f}\\n",
        "enabled": true
      }
    ]
  },
