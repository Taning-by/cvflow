          }
        },
        {
          "id": "28946263",
          "type": "output.save_image",
          "name": "NG 存图",
          "enabled": true,
          "position": [
            1510.0,
            210.0
          ],
          "values": {
            "directory": "../../captures",
            "when": "ng_only",
            "format": "png",
            "subfolder_by_result": true,
            "prefix": "",
            "jpeg_quality": 92
          }
        }
