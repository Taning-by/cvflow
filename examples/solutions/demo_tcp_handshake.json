          "values": {
            "op": "==",
            "low": 3.0,
            "high": 100.0,
            "text": "",
            "name": "holes"
          }
        },
        {
          "id": "9dc713f8",
          "type": "analysis.circle",
          "name": "定位",
          "enabled": true,
