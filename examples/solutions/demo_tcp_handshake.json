{
  "format": 1,
  "name": "demo_tcp_handshake",
  "plugin_dirs": [],
  "variables": {
    "product": {
      "value": "PART-A",
      "dtype": "string",
      "description": "当前产品型号"
    },
    "last_request": {
      "value": 0,
      "dtype": "int",
      "description": "最近一次请求编号"
    }
  },
  "comm": {
    "devices": [
      {
        "name": "上位机",
        "kind": "tcp_server",
        "config": {
          "host": "0.0.0.0",
          "port": 6000,
          "max_clients": 8,
          "default_target": "broadcast",
          "framing": "delimiter",
          "terminator": "\\n",
          "encoding": "utf-8",
          "max_frame": 4096,
          "frame_timeout_s": 2.0,
          "heartbeat_s": 0.0,
          "heartbeat_text": "HB\\n",
          "auto_connect": true,
          "connect_timeout_s": 3.0,
          "request_timeout_s": 1.0
        }
      }
    ],
    "parse_rules": [
      {
        "name": "request",
        "kind": "delimited",
        "separator": ",",
        "encoding": "utf-8",
        "strip": true,
        "to_variables": false,
        "fields": [
          {
            "name": "cmd",
            "index": 0,
            "dtype": "string"
          },
          {
            "name": "request_id",
            "index": 1,
            "dtype": "int"
          }
        ]
      }
    ],
    "format_rules": [
      {
        "name": "result",
        "kind": "text",
        "separator": ",",
        "terminator": "\\n",
        "missing": "",
        "fields": [
          {
            "name": "head",
            "source": "literal:RESULT"
          },
          {
            "name": "request_id",
            "source": "request_id",
            "dtype": "int"
          },
          {
            "name": "status",
            "source": "status"
          },
          {
            "name": "x",
            "source": "out.x",
            "dtype": "float",
            "decimals": 3
          },
          {
            "name": "y",
            "source": "out.y",
            "dtype": "float",
            "decimals": 3
          },
          {
            "name": "angle",
            "source": "out.angle",
            "dtype": "float",
            "decimals": 3
          }
        ]
      },
      {
        "name": "busy",
        "kind": "text",
        "separator": ",",
        "terminator": "\\n",
        "fields": [
          {
            "name": "head",
            "source": "literal:BUSY"
          },
          {
            "name": "request_id",
            "source": "request_id",
            "dtype": "int"
          }
        ]
      },
      {
        "name": "error",
        "kind": "text",
        "separator": ",",
        "terminator": "\\n",
        "fields": [
          {
            "name": "head",
            "source": "literal:ERROR"
          },
          {
            "name": "request_id",
            "source": "request_id",
            "dtype": "int"
          },
          {
            "name": "code",
            "source": "error_code",
            "dtype": "int"
          }
        ]
      },
      {
        "name": "result_json",
        "kind": "json",
        "terminator": "\\n",
        "json_indent": 0,
        "fields": [
          {
            "name": "request_id",
            "source": "request_id",
            "dtype": "int"
          },
          {
            "name": "status",
            "source": "status"
          },
          {
            "name": "holes",
            "source": "out.holes",
            "dtype": "int"
          },
          {
            "name": "x",
            "source": "out.x",
            "dtype": "float",
            "decimals": 3
          },
          {
            "name": "y",
            "source": "out.y",
            "dtype": "float",
            "decimals": 3
          },
          {
            "name": "angle",
            "source": "out.angle",
            "dtype": "float",
            "decimals": 3
          },
          {
            "name": "width",
            "source": "out.width",
            "dtype": "float",
            "decimals": 2
          }
        ]
      }
    ],
    "receive_rules": [
      {
        "name": "触发检测",
        "device": "上位机",
        "source": "message",
        "match": "startswith",
        "pattern": "TRIGGER",
        "action": "trigger_flow",
        "flow": "main",
        "parse": "request",
        "request_field": "request_id",
        "busy_policy": "reject",
        "max_queue": 1,
        "enabled": true
      }
    ],
    "send_rules": [],
    "handshakes": [
      {
        "name": "检测握手",
        "device": "上位机",
        "flow": "main",
        "mode": "text",
        "enabled": true,
        "result_format": "result",
        "busy_format": "busy",
        "error_format": "error",
        "busy_policy": "reject",
        "run_timeout_s": 5.0,
        "dedup_window_s": 3.0,
        "dedup_action": "resend"
      }
    ]
  },
  "flows": [
    {
      "name": "main",
      "description": "取图 → 灰度 → 阈值 → 开运算 → 数孔；两把卡尺量宽度与偏转角；圆查找给出定位坐标。发布 holes / x / y / angle / width。",
      "nodes": [
        {
          "id": "547819fe",
          "type": "source.image_folder",
          "name": "取图",
          "enabled": true,
          "position": [
            40.0,
            60.0
          ],
          "values": {
            "directory": "../images",
            "mode": "next",
            "index": 0,
            "loop": true,
            "grayscale": false,
            "roi_enabled": false,
            "roi_w": 628,
            "roi_h": 768,
            "roi": null
          }
        },
        {
          "id": "c42a2607",
          "type": "preprocess.color",
          "name": "灰度",
          "enabled": true,
          "position": [
            250.0,
            60.0
          ],
          "values": {
            "mode": "gray",
            "channel": -1
          }
        },
        {
          "id": "c59035a3",
          "type": "preprocess.threshold",
          "name": "阈值",
          "enabled": true,
          "position": [
            460.0,
            60.0
          ],
          "values": {
            "method": "binary_inv",
            "thresh": 120,
            "high": 255,
            "block_size": 31,
            "c": 5.0
          }
        },
        {
          "id": "2536f899",
          "type": "preprocess.morphology",
          "name": "开运算",
          "enabled": true,
          "position": [
            670.0,
            60.0
          ],
          "values": {
            "op": "open",
            "shape": "ellipse",
            "ksize": 3,
            "iterations": 1
          }
        },
        {
          "id": "f21a4f5d",
          "type": "analysis.blob",
          "name": "孔",
          "enabled": true,
          "position": [
            880.0,
            60.0
          ],
          "values": {
            "binarize": "auto",
            "polarity": "bright",
            "low": 128,
            "high": 255,
            "min_area": 500,
            "max_area": 5000,
            "min_width": 0,
            "min_height": 0,
            "connectivity": "8",
            "sort": "area_desc",
            "max_count": 100
