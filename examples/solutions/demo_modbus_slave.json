          ],
          "values": {
            "roi": {
              "x": 60.0,
              "y": 240.0,
              "w": 520.0,
              "h": 20.0,
              "angle": 0.0
            },
            "direction": "horizontal",
            "polarity": "any",
            "min_contrast": 15.0,
