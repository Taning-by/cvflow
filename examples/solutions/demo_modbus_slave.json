          ],
          "values": {
            "name_a": "width",
            "name_b": "b",
            "name_c": "c",
            "name_d": "d"
          }
        },
        {
          "id": "95af4d87",
          "type": "output.render",
          "name": "渲染",
          "enabled": true,
          "position": [
            1300.0,
            210.0
          ],
          "values": {
            "thickness": 1,
            "stamp_result": true
          }
        },
        {
          "id": "740a352c",
          "type": "output.save_image",
          "name": "NG 存图",
          "enabled": true,
          "position": [
            1510.0,
            210.0
          ],
          "values": {
            "directory": "../../captures",
            "when": "ng_only",
            "format": "png",
            "subfolder_by_result": true,
            "prefix": "",
