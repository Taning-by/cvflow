          ],
          "values": {
            "name_a": "holes",
            "name_b": "x",
            "name_c": "y",
            "name_d": "angle"
          }
        },
        {
          "id": "1b620d79",
          "type": "output.publish",
          "name": "发布宽度",
          "enabled": true,
          "position": [
