{
  "format": 1,
  "name": "demo_modbus_slave",
  "plugin_dirs": [],
  "variables": {
    "product": {
      "value": "PART-A",
      "dtype": "string",
      "description": "当前产品型号"
    },
    "last_request": {
      "value": 0,
      "dtype": "int",
      "description": "最近一次请求编号"
    }
  },
  "comm": {
    "devices": [
      {
        "name": "PLC",
        "kind": "modbus_tcp_server",
        "config": {
          "host": "0.0.0.0",
          "port": 5020,
          "unit_id": 1,
          "register_count": 64,
          "input_count": 16,
          "coil_count": 16,
          "discrete_count": 16,
          "allow_remote_write": true,
          "max_clients": 4,
          "busy_address": -1,
          "trigger_reset": false,
          "heartbeat_address": 30,
          "auto_connect": true,
          "heartbeat_s": 1.0
        },
        "points": [
          {
            "name": "trigger",
            "area": "holding",
            "address": 0,
            "dtype": "int16",
            "direction": "read_write",
            "poll_ms": 20,
            "description": "对端写 1 触发一次检测"
          },
          {
            "name": "request_id",
            "area": "holding",
            "address": 1,
            "dtype": "int32",
            "layout": "CDAB",
            "direction": "read_write",
            "poll_ms": 20,
            "description": "本次请求编号，由对端写入"
          },
          {
            "name": "ready",
            "area": "holding",
            "address": 3,
            "dtype": "int16",
            "direction": "write",
            "description": "1=可以接受新任务"
          },
          {
            "name": "busy",
            "area": "holding",
            "address": 4,
            "dtype": "int16",
            "direction": "write",
            "description": "1=正在执行"
          },
          {
            "name": "done",
            "area": "holding",
            "address": 5,
            "dtype": "int16",
            "direction": "write",
            "description": "1=结果已写完，可以读了"
          },
          {
            "name": "result",
            "area": "holding",
            "address": 6,
            "dtype": "int16",
            "direction": "write",
            "description": "1=OK，2=NG"
          },
          {
            "name": "error_code",
            "area": "holding",
            "address": 7,
            "dtype": "int16",
            "direction": "write",
            "description": "0 正常；1 忙 2 参数错 3 流程异常 4 超时 5 未运行 6 重复"
          },
          {
            "name": "done_id",
            "area": "holding",
            "address": 8,
            "dtype": "int32",
            "layout": "CDAB",
            "direction": "write",
            "description": "本次完成对应的请求编号"
          },
          {
            "name": "ack",
            "area": "holding",
            "address": 10,
            "dtype": "int16",
            "direction": "read_write",
            "poll_ms": 20,
            "description": "对端写 1 表示已取走结果"
          },
          {
            "name": "holes",
            "area": "holding",
            "address": 20,
            "dtype": "int16",
            "direction": "write",
            "description": "孔数"
          },
          {
            "name": "x",
            "area": "holding",
            "address": 21,
            "dtype": "float32",
            "layout": "CDAB",
            "direction": "write",
            "description": "定位 X（像素）"
          },
          {
            "name": "y",
            "area": "holding",
            "address": 23,
            "dtype": "float32",
            "layout": "CDAB",
            "direction": "write",
            "description": "定位 Y（像素）"
          },
          {
            "name": "angle",
            "area": "holding",
            "address": 25,
            "dtype": "float32",
            "layout": "CDAB",
            "direction": "write",
            "description": "偏转角（度）"
          },
          {
            "name": "width",
            "area": "holding",
            "address": 27,
            "dtype": "float32",
            "layout": "CDAB",
            "direction": "write",
            "description": "宽度（像素）"
          },
          {
            "name": "heartbeat",
            "area": "holding",
            "address": 30,
            "dtype": "int16",
            "direction": "write",
            "description": "视觉在线心跳，每秒自增"
          }
        ]
      }
    ],
    "receive_rules": [
      {
        "name": "触发检测",
        "device": "PLC",
        "source": "datapoint",
        "match": "rising",
        "point": "trigger",
        "action": "trigger_flow",
        "flow": "main",
        "request_field": "request_id",
        "busy_policy": "reject",
        "max_queue": 1,
        "enabled": true
      }
    ],
    "send_rules": [
      {
        "name": "回传结果",
        "device": "PLC",
        "flow": "main",
        "when": "always",
        "template": "",
        "points": [
          {
            "point": "holes",
            "source": "out.holes"
          },
          {
            "point": "x",
            "source": "out.x"
          },
          {
            "point": "y",
            "source": "out.y"
          },
          {
            "point": "angle",
            "source": "out.angle"
          },
          {
            "point": "width",
            "source": "out.width"
          }
        ],
        "enabled": true
      }
    ],
    "handshakes": [
      {
        "name": "检测握手",
        "flow": "main",
        "mode": "register",
        "enabled": true,
        "ready": "ready",
        "busy": "busy",
        "done": "done",
        "result": "result",
        "error_code": "error_code",
        "request_id": "request_id",
        "done_id": "done_id",
        "ack": "ack",
        "ack_value": 1,
        "ok_value": 1,
        "ng_value": 2,
        "require_ack": true,
        "auto_reset_s": 10.0,
        "run_timeout_s": 5.0,
        "busy_policy": "reject",
        "max_queue": 1,
        "dedup_window_s": 3.0,
        "dedup_action": "ignore",
        "device": "PLC"
      }
    ]
  },
  "flows": [
    {
      "name": "main",
      "description": "取图 → 灰度 → 阈值 → 开运算 → 数孔；两把卡尺量宽度与偏转角；圆查找给出定位坐标。发布 holes / x / y / angle / width。",
      "nodes": [
        {
          "id": "e9049f09",
          "type": "source.image_folder",
          "name": "取图",
          "enabled": true,
          "position": [
            40.0,
            60.0
          ],
          "values": {
            "directory": "../images",
            "mode": "next",
            "index": 0,
            "loop": true,
            "grayscale": false
          }
        },
        {
          "id": "20ffe023",
          "type": "preprocess.color",
          "name": "灰度",
          "enabled": true,
          "position": [
            250.0,
            60.0
          ],
          "values": {
            "mode": "gray",
            "channel": -1
          }
        },
        {
          "id": "2a60099b",
          "type": "preprocess.threshold",
          "name": "阈值",
          "enabled": true,
          "position": [
            460.0,
            60.0
